# ========================================================
# Aavritti Cloud Internet Radio - Environment Variables
# ========================================================

# Public URL of the deployed application (used for CSRF and Origin checks)
APP_ORIGIN=https://aavritti.amalskumar.dev

# ESP32 Device Identifier (must match the deviceId configured in the firmware)
DEVICE_ID=esp32-radio-01

# HiveMQ Cloud Serverless (or EMQX) MQTT Broker
# Format: mqtts://<cluster-id>.s1.eu.hivemq.cloud:8883 (or mqtt://localhost:1883 for local dev)
MQTT_URL=mqtts://your-cluster-id.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=aavritti_backend
MQTT_PASSWORD=your_backend_mqtt_password

# Authentication
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace_with_32_bytes_random_secret_string
# Generate with: pnpm run hash-password <your_password>
ADMIN_PASSWORD_HASH=$2a$12$eX4mP1eHaShVaLuEgOesHeReFoRAdMiNpAsSwOrD

# Upstash Redis (Serverless KV store for favorites, play history, rate limits)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
